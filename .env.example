# ─── Base de Datos SQL Server ─────────────────────────────────────────────────
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_PORT=1433
DB_DATABASE=

# ─── Holded ERP ───────────────────────────────────────────────────────────────
HOLDED_API_KEY=

# ─── Shopify (Tienda 1) ───────────────────────────────────────────────────────
SHOPIFY_STORE_1_URL=
SHOPIFY_STORE_1_TOKEN=
# Opcional: si usas OAuth en lugar de token directo
# SHOPIFY_STORE_1_CLIENT_ID=
# SHOPIFY_STORE_1_CLIENT_SECRET=

# ─── Shopify (Tienda 2) ───────────────────────────────────────────────────────
SHOPIFY_STORE_2_URL=
SHOPIFY_STORE_2_TOKEN=

# ─── Miravia ──────────────────────────────────────────────────────────────────
MIRAVIA_APP_KEY=
MIRAVIA_APP_SECRET=
MIRAVIA_ACCESS_TOKEN=
MIRAVIA_REFRESH_TOKEN=

# ─── Sendcloud ────────────────────────────────────────────────────────────────
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Google Sheets (sincronización de logs) ───────────────────────────────────
LOGS_SHEET_ID=
SYNC_SCRIPT_URL=
LOGS_SHEET_URL=

# ─── Frontend (contraseñas de usuarios - prefijo VITE_) ───────────────────────
VITE_ADMIN_PASSWORD=
VITE_ALICIA_PASSWORD=
VITE_ROSA_PASSWORD=
VITE_SANDRA_PASSWORD=

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
